{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonJS",
    "moduleResolution": "Node10",
    "rootDir": "./src",
    "strict": true,
    "declaration": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}