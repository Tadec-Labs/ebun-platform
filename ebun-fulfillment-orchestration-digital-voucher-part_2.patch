+      expect(typeof createCall.vtuRequestId).toBe('string');
+      expect(createCall.vtuRequestId.length).toBeGreaterThan(0);
+
+      expect(vtuProvider.topUp).toHaveBeenCalledWith({
+        requestId: createCall.vtuRequestId,
