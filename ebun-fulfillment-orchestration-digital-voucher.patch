+}
+
+describe('FulfillmentOrchestratorService', () => {
+  let sut: FulfillmentOrchestratorService;
+  let orders: { findById: jest.Mock; transitionNormal: jest.Mock };
+  let gifts: { findById: jest.Mock };
+  let fulfillments: {
